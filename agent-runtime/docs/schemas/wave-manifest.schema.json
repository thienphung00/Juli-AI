{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juli.ai/schemas/agent-runtime/wave-manifest.schema.json",
  "title": "Wave Manifest",
  "description": "Committed wave branch manifest listing merged issue numbers for artifact-gate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["waveId", "branch", "issues"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "artifactType": {
      "const": "wave_manifest"
    },
    "waveId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^wave-.+$"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "pattern": "^feature/.+-wave$"
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
