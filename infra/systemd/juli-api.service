# App Review backend service — FastAPI (uvicorn) on 127.0.0.1:8000
#
# Independent of juli-web: restart with `sudo systemctl restart juli-api`.
# Install to /etc/systemd/system/juli-api.service on the review VPS.
#
# VPS layout (continuous delivery, see release.yml + deploy-release.sh):
#   ~/releases/current -> ~/releases/<sha>   symlink flipped on every deploy
#   /etc/juli/api.env                        generated by fetch-secrets.sh
#                                             (AWS Secrets Manager, juli/api/production)
# App Review envelope: single web process only. Deferred background services are
# out of scope for review — see docs/runbooks/app-review-runbook.md.
[Unit]
Description=Juli App Review backend (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/releases/current
# Re-fetch secrets on every start/restart (crash, reboot, manual restart) so the
# env file is never stale for longer than one restart cycle. Path is the stable
# canonical checkout, not a release dir, so it survives release pruning.
ExecStartPre=/root/Juli-AI-v2/infra/scripts/fetch-secrets.sh
# Env file lives on the VPS only, outside any release dir — see
# infra/scripts/fetch-secrets.sh and the "Secrets" section of app-review-runbook.md.
EnvironmentFile=/etc/juli/api.env
# Single worker is sufficient for review; no HA/multi-worker tuning in Phase 2.5.
# #843: the API lane alternates 8000/8020; the deploy records the live port so a
# reboot brings this unit back on the port nginx is pointed at.
Environment=API_LIVE_PORT=8000
EnvironmentFile=-/etc/juli/api-runtime.env
# --proxy-headers makes uvicorn read X-Forwarded-For/-Proto so request.client.host is
# the real caller rather than nginx's loopback address. Without it every security event
# added by #905 — rejected webhook signatures, auth and ownership failures — is
# attributed to 127.0.0.1 and cannot be traced to a source.
#
# --forwarded-allow-ips is scoped to the loopback nginx actually proxies from, and that
# scoping is load-bearing: trusting the header from any source would let a client spoof
# X-Forwarded-For and write an address of their choosing into our audit trail. The real
# client address is only trustworthy because nginx overwrites it from CF-Connecting-IP
# first (conf.d/cloudflare-real-ip.conf, generated by cloudflare-origin-lockdown.sh).
ExecStart=/root/releases/current/.venv/bin/uvicorn juli_backend.api.main:app \
    --host 127.0.0.1 --port ${API_LIVE_PORT} --workers 1 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
