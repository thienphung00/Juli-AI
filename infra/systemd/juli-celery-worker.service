# Celery worker for async task execution
#
# Executes background tasks queued by the FastAPI application (e.g., mock analytics
# reconciliation, CDP compute orchestration). Subscribes to CELERY_BROKER_URL (Redis on
# localhost) for task dispatch. Always runs with CELERY_RESULT_BACKEND for task result
# persistence.
#
# Install to /etc/systemd/system/juli-celery-worker.service on the review VPS.
#
# VPS layout (continuous delivery, see release.yml + deploy-release.sh):
#   ~/releases/current -> ~/releases/<sha>   symlink flipped on every deploy
#   /etc/juli/api.env                        generated by fetch-secrets.sh
#                                             (AWS Secrets Manager, juli/api/production)
#
[Unit]
Description=Juli Celery worker for async tasks
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/releases/current
# Re-fetch secrets on every start/restart so the env file is never stale.
ExecStartPre=/root/Juli-AI-v2/infra/scripts/fetch-secrets.sh
# Env file lives on the VPS only, outside any release dir.
# AGENT_WORKFLOWS_ENABLED (see infra/scripts/env/api.env.example) rides in via this
# EnvironmentFile like every other flag. It gates agent_broker_guard.py's fail-closed
# boot assertion (#1129, ADR-074 decision 4): a truthy value requires CELERY_BROKER_URL
# to resolve to a real broker, never memory://, or the worker refuses to start agent
# workflow paths. Leaving it unset/false here is what keeps that path off by default.
EnvironmentFile=/etc/juli/api.env
# Single worker is sufficient for review; no HA/multi-worker tuning in Phase 2.5.
#
# `-Q celery,agent_runs,credentials` (issue #1205, extended #1232). `workers/celery_app.py`'s
# task_routes send run_agent_workflow / resume_agent_workflow to a DEDICATED `agent_runs`
# queue per ADR-074 decision 4, and credential_refresh_beat to a DEDICATED `credentials`
# queue per ADR-081 decision 6. With no -Q flag celery consumes only the default `celery`
# queue, so those tasks enqueued into a queue nobody read: every agent run returned
# a celery_task_id, then sat at status=queued with zero events forever (observed on
# the VPS 2026-08-19). All three queues must be listed -- dropping `celery` here would
# strand every non-agent, non-credential task instead.
#
# If a queue is ever added to task_routes, it must be added here too; nothing else
# reconciles the two.
#
# Fast track P1-B adds `ingest_priority` (bootstrap_shop -- a new shop's fast phase) and
# `ingest_backfill` (shop_history_backfill -- the low-priority history walk). One worker
# consuming every queue gives no strict priority between them; a dedicated
# `-Q ingest_priority` worker is the follow-up if connects ever queue behind history.
# Fast track P15 adds `content_analysis` (analyze_content_upload, content_analysis_sweep):
# ffmpeg + OpenAI work on seller-uploaded videos; needs ffmpeg/ffprobe on the box and
# CONTENT_ANALYSIS_UPLOAD_DIR writable (see docs/runbooks/content-analysis-runbook.md).
# A dedicated `-Q content_analysis --concurrency 1` unit is the follow-up if analyses
# ever delay agent runs (fasttrack/DEBT.md).
ExecStart=/root/releases/current/.venv/bin/celery -A juli_backend.workers.celery_app worker \
    -Q celery,agent_runs,credentials,ingest_priority,ingest_backfill,content_analysis \
    --loglevel=info
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
