# Celery Beat scheduler for periodic tasks
#
# Schedules and dispatches recurring background tasks on a timer (e.g., hourly mock
# analytics reconciliation defined in celery_app.beat_schedule). Reads the schedule
# from the application and enqueues jobs to CELERY_BROKER_URL (Redis on localhost).
#
# Install to /etc/systemd/system/juli-celery-beat.service on the review VPS.
#
# VPS layout (continuous delivery, see release.yml + deploy-release.sh):
#   ~/releases/current -> ~/releases/<sha>   symlink flipped on every deploy
#   /etc/juli/api.env                        generated by fetch-secrets.sh
#                                             (AWS Secrets Manager, juli/api/production)
#
[Unit]
Description=Juli Celery Beat scheduler for periodic tasks
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/releases/current
# Re-fetch secrets on every start/restart so the env file is never stale.
ExecStartPre=/usr/bin/mkdir -p /var/lib/juli
ExecStartPre=/root/Juli-AI-v2/infra/scripts/fetch-secrets.sh
# Env file lives on the VPS only, outside any release dir.
# AGENT_WORKFLOWS_ENABLED (see infra/scripts/env/api.env.example) rides in via this
# EnvironmentFile like every other flag. It gates agent_broker_guard.py's fail-closed
# boot assertion (#1129, ADR-074 decision 4): a truthy value requires CELERY_BROKER_URL
# to resolve to a real broker, never memory://, or beat refuses to start agent workflow
# paths. Leaving it unset/false here is what keeps that path off by default.
EnvironmentFile=/etc/juli/api.env
# Single beat scheduler is sufficient for review; no HA/multi-worker tuning in Phase 2.5.
# --schedule must point outside the release tree. Without it, Celery Beat writes
# celerybeat-schedule into WorkingDirectory, which is a symlink into a per-release
# directory that flips on every deploy and is pruned by KEEP_RELEASES. Beat's record
# of when each entry last ran then vanishes underneath it, and a schedule that never
# fires produces no error — it simply does nothing.
ExecStart=/root/releases/current/.venv/bin/celery -A juli_backend.workers.celery_app beat \
    --schedule=/var/lib/juli/celerybeat-schedule \
    --loglevel=info
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
