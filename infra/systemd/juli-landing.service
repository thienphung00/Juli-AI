# Landing page service — Next.js (apps/landing) on 127.0.0.1:3007 (#841)
#
# The landing page's first production home. It has no backend dependency of any
# kind, so this unit is fully independent of juli-api, juli-web, and juli-demo:
# deploying or restarting it never touches them, and vice versa.
#
# WHICH PORT. 3007 is the port apps/landing/package.json already encodes for
# `next start`, adopted as the one landing port so dev and production agree.
# It is unique across the host: 8000 api, 3000 web, 3001/3021 demo blue-green
# lane, 6379 redis. 3027 is RESERVED as the landing candidate peer for the
# paired-slot lane (#843) — do not assign it to anything else.
#
# Loopback only, on purpose: #841 gives Landing a port, not a domain. The main
# domain repoint is #842 and needs no change here — nginx will proxy to this
# same port.
#
# Start the local Next binary directly (not `corepack pnpm run start`) so systemd
# does not depend on corepack preparing pnpm in a minimal service environment.
#
# VPS layout (see deploy-landing-release.sh):
#   ~/releases/landing-current -> ~/releases/<sha>   flipped on every Landing deploy
# Install to /etc/systemd/system/juli-landing.service on the review VPS.
[Unit]
Description=Juli Landing page (apps/landing)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/releases/landing-current/apps/landing
# Production Next.js server bound to the loopback port nginx will later proxy to (#842).
Environment=LANDING_LIVE_PORT=3007
EnvironmentFile=-/etc/juli/landing-runtime.env
# TIKTOK EVENTS API TOKEN (server channel).
#
# /etc/juli/frontend.env carries TIKTOK_EVENTS_API_ACCESS_TOKEN for the relay
# route at /api/tt/event. It is a SEPARATE file from the runtime env above on
# purpose: deploy.sh truncates and rewrites landing-runtime.env on every
# deploy (write_runtime_env), so a secret placed there would survive exactly
# until the next release. The `-` prefix keeps the unit starting on a host
# where the secret has not been provisioned; the route then answers 503 and
# says so in the journal.
EnvironmentFile=-/etc/juli/frontend.env
ExecStart=/root/releases/landing-current/apps/landing/node_modules/.bin/next start --port ${LANDING_LIVE_PORT} --hostname 127.0.0.1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
