# App Review backend env template — api.app-juli.com
#
# Copy to ~/Juli-AI-v2/.env on the VPS and fill in real values there.
# NEVER commit real values. Secrets live outside source control (VPS env file
# or a secret manager). Placeholders below are intentionally non-functional.

# Environment discriminator (ADR-061). Unset defaults to non-production, so
# this must be set explicitly here rather than relying on the default.
ENVIRONMENT=production

# Required at startup (FastAPI lifespan opens the DB engine).
#
# Use the Session pooler URI on IPv4-only VPS hosts (most cloud VPS). Direct
# db.*.supabase.co hosts are IPv6-only and will fail with "Connection refused".
# Supabase Dashboard → Connect → Session mode → URI (port 5432).
DATABASE_URL=postgresql://postgres.REPLACE_PROJECT_REF:REPLACE_PASSWORD@aws-0-REPLACE_REGION.pooler.supabase.com:5432/postgres

# Direct connection URI — used for migrations (alembic).
DATABASE_DIRECT_URL=postgresql://postgres.REPLACE_PROJECT_REF:REPLACE_PASSWORD@db.REPLACE_PROJECT_REF.supabase.co:5432/postgres

# Supabase project configuration.
SUPABASE_URL=https://REPLACE_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# JWT validation for protected API routes. Required — the API refuses to
# authenticate requests without it (no empty-secret fallback).
SUPABASE_JWT_SECRET=REPLACE_ME

# TikTok OAuth + webhook signature verification (Partner Center sandbox app for
# review). Also required for POST /webhooks/tiktok (Issue #381) — the webhook
# ingress route is mounted on this same juli-api process, not a separate service.
TIKTOK_APP_KEY=REPLACE_ME
TIKTOK_APP_SECRET=REPLACE_ME
# Optional — CI integration tests (issue #366); never commit real values.
# TIKTOK_SANDBOX_AUTH_CODE=REPLACE_ME
# TIKTOK_SANDBOX_REFRESH_TOKEN=REPLACE_ME
# Preferred key for encrypting persisted TikTok OAuth tokens.
TIKTOK_TOKEN_ENCRYPTION_KEY=REPLACE_ME

# Operator merchant identity (issue #1234): which authorized shop's `open_id`
# counts as "our" production-read / sandbox-write merchant for capability
# isolation (integrations/tiktok/merchant.py). This is a Juli-internal label,
# not something TikTok's API exposes -- a NEW deployment MUST set both to its
# own shops' open_id, found via GET /authorization/{v}/shops after connecting
# them, or it silently falls back to Juli's own IDs hardcoded as the default
# in merchant.py (see that module's docstring).
# TIKTOK_PRODUCTION_MERCHANT_ID=REPLACE_ME
# TIKTOK_SANDBOX_MERCHANT_ID=REPLACE_ME

# TikTok for Business / Marketing API OAuth (separate app from Shop Partner).
# Redirect URIs must match the TikTok for Business portal registration exactly
# (ADR-034). Renaming registered portal URIs is high-risk — do not change these
# paths without a coordinated portal + secrets update.
TIKTOK_BUSINESS_APP_ID=REPLACE_ME
TIKTOK_BUSINESS_APP_SECRET=REPLACE_ME
TIKTOK_BUSINESS_REDIRECT_URI=https://api.app-juli.com/v1/auth/tiktok/business/callback
TIKTOK_BUSINESS_ACCOUNT_HOLDER_REDIRECT_URI=https://api.app-juli.com/v1/auth/tiktok/business/account-holder/callback

# Temporary TikTok debug routes (GET /debug/tiktok/verify-connection).
# Set to 1 during App Review; leave unset or 0 in production.
# ENABLE_TIKTOK_DEBUG=1
#
# OAuth token persistence requires base tables — on first deploy run:
#   cd ~/Juli-AI-v2 && .venv/bin/alembic upgrade 001

# CORS: allow the review frontend origin to call the API.
CORS_ALLOW_ORIGINS=https://app-juli.com

# --- Phase 2.10 product VPS (A11 / #535) — co-located Redis on loopback ---
# App cache + rate-limit / material gate (DB 0). Postgres remains SoT; Redis is
# ephemeral (no RDB/AOF). See ADR-041.
# REDIS_URL=redis://127.0.0.1:6379/0
# DEMO_REFERENCE_SHOP_ID=REPLACE_WITH_FUJIWA_SHOP_UUID
# CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
#
# Uncomment REDIS_URL, CELERY_BROKER_URL, and CELERY_RESULT_BACKEND above when
# enabling the juli-celery-worker and juli-celery-beat systemd units (Issue #720).
# These are required for background task execution (async reconciliation, CDP compute).
# For App Review without background workers, leave them unset. TikTok webhook ingress
# (#381) is a route on this same process; it needs no additional service or port
# beyond TikTok credentials above.

# --- Agent workflows (ADR-074 decision 4, #1129, Issue #1164) ---
# Fail-closed contract: agent_broker_guard.py asserts at Celery boot that when
# AGENT_WORKFLOWS_ENABLED is truthy, CELERY_BROKER_URL must resolve to a real
# broker (e.g. redis://...), never the in-memory transport (memory://). A real
# Redis broker is required to enable agent workflows — the API/worker refuse to
# start agent workflow paths otherwise (RuntimeError at import time). Default is
# off (false): unset or any non-truthy value always leaves the deployment on the
# permissive, non-agent path, never a silent auto-enable. Flip to true only once
# REDIS_URL / CELERY_BROKER_URL / CELERY_RESULT_BACKEND above are uncommented and
# pointed at a real broker.
AGENT_WORKFLOWS_ENABLED=false

# --- Content analysis of seller uploads (fast track P15) ---
# All optional; defaults shown. The upload dir must be writable by the API and the
# Celery worker (same box) and must NOT be under any web-served path.
# CONTENT_ANALYSIS_UPLOAD_DIR=/var/lib/juli/content-uploads
# CONTENT_UPLOAD_SIGNING_SECRET=            # else SUPABASE_JWT_SECRET (domain-separated)
# CONTENT_ANALYSIS_ASR_MODEL=whisper-1      # word timestamps; gpt-4o-mini-transcribe = cheaper, 30 s slices
# CONTENT_ANALYSIS_VISION_MODEL=gpt-5.4-nano
# CONTENT_ANALYSIS_SCORING_MODEL=gpt-5.4-nano
# OPENAI_MONTHLY_COST_CAP_USD=5             # per shop; shop_rules `openai_monthly_cap_usd` overrides
# CONTENT_ANALYSIS_VIDEO_MAX_MB=500
# CONTENT_ANALYSIS_LIVE_MAX_MB=4096
# CONTENT_ANALYSIS_LIVE_SCAN_MAX_MINUTES=60
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe

# --- Juli Ops console (fast track P16, D25; docs/runbooks/ops-console-runbook.md) ---
# Cloudflare Zero Trust team domain ("<team>" or "<team>.cloudflareaccess.com") and the
# AUD tag of the ops.app-juli.com Access application. Both required in production:
# /v1/ops/* refuses every request (403) while either is missing.
CF_ACCESS_TEAM_DOMAIN=REPLACE_TEAM
CF_ACCESS_AUD=REPLACE_AUD_TAG
# Only addresses in this domain pass (defence in depth behind the Access policy).
OPS_ALLOWED_EMAIL_DOMAIN=app-juli.com
# NEVER set in production (refused there): skips the Access check for local dev/tests.
# OPS_CF_ACCESS_BYPASS=1
# "Mời seller" / "Huỷ kết nối" e-mails. Unset host = no e-mail; Ops shows the link instead.
OPS_SMTP_HOST=
OPS_SMTP_PORT=587
OPS_SMTP_USER=
OPS_SMTP_PASSWORD=
OPS_MAIL_FROM=Juli <no-reply@app-juli.com>
# Where the seller accepts an invite (the seller app).
OPS_INVITE_ACCEPT_BASE_URL=https://demo.app-juli.com
