{
  "name": "juli-ai-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "build:demo": "turbo run build --filter=@juli/demo",
    "lint": "turbo run lint",
    "lint:demo": "turbo run lint --filter=@juli/demo",
    "type-check": "turbo run type-check",
    "type-check:demo": "turbo run type-check --filter=@juli/demo",
    "test": "turbo run test",
    "test:demo": "turbo run test --filter=@juli/demo",
    "check:demo": "pnpm lint:demo && pnpm type-check:demo && pnpm test:demo && pnpm --filter @juli/ui test && pnpm --filter @juli/utils test && pnpm build:demo",
    "build:landing": "turbo run build --filter=@juli/landing",
    "lint:landing": "turbo run lint --filter=@juli/landing",
    "type-check:landing": "turbo run type-check --filter=@juli/landing",
    "test:landing": "turbo run test --filter=@juli/landing",
    "check:landing": "pnpm lint:landing && pnpm type-check:landing && pnpm test:landing && pnpm build:landing",
    "screenshots": "node scripts/capture-ui-screenshots.mjs",
    "screenshots:install": "playwright install chromium",
    "dev": "pnpm dev:dashboard & pnpm dev:demo & pnpm dev:landing & wait",
    "dev:dashboard": "npm --prefix apps/dashboard run dev",
    "dev:demo": "pnpm --filter @juli/demo exec next dev -p 3100",
    "dev:landing": "pnpm --filter @juli/landing exec next dev -p 3007",
    "setup": "pnpm install && npm --prefix apps/dashboard ci"
  },
  "devDependencies": {
    "playwright": "^1.52.0",
    "turbo": "2.10.5"
  }
}
